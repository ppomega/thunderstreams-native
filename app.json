{
  "expo": {
    "name": "Thunder Streams",
    "slug": "thunderstreams",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.ppomega.thunderstreams"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.ppomega.thunderstreams"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-image",
      "expo-font",
      "expo-splash-screen"
    ],
    "scheme": "thunderstreams",
    "backgroundColor": "#1b0618",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "69f5b066-459c-45b0-8b02-965fbdc4ac1f"
      }
    }
  }
}
